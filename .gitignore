# Python bytecode and virtual environment
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Large raw NetCDF and satellite/in-situ data downloads
data/raw/
data/processed/**/*.npz
data/processed/*.npz
data/processed/**/*.npy
data/processed/*.npy
data/processed/**/*.nc
data/processed/*.nc

# Large model weights — tracked via Git LFS (not gitignored)
# *.pt files are stored in Git LFS automatically via .gitattributes
results/embeddings/
results/metrics/*.npz

# Operating system artifacts & temporary logs
.DS_Store
Thumbs.db
*.log
scratch/

# Frontend build artifacts & dependencies
frontend/node_modules/
frontend/.next/
frontend/.vercel/

# Environment variable files — NEVER commit these
.env
.env.local
.env.production
.env*.local
frontend/.env
frontend/.env.local
frontend/.env.production

# Agent/IDE artifacts
.agents/
.claude/
skills-lock.json

